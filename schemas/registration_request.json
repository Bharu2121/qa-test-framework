{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "StudentRegistrationRequest",
    "type": "object",
    "required": [
        "city",
        "dateOfBirth",
        "email",
        "firstName",
        "gender",
        "lastName",
        "mobile",
        "preferredCountry",
        "qualification",
        "state"
    ],
    "properties": {
        "firstName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100,
            "pattern": "^[a-zA-Z\\s]+$"
        },
        "lastName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100,
            "pattern": "^[a-zA-Z\\s]+$"
        },
        "dateOfBirth": {
            "type": "string",
            "format": "date"
        },
        "gender": {
            "type": "string",
            "pattern": "^(Male|Female|Prefer not to say)$"
        },
        "email": {
            "type": "string",
            "maxLength": 255
        },
        "mobile": {
            "type": "string",
            "pattern": "^[6-9]\\d{9}$"
        },
        "whatsapp": {
            "type": [
                "string",
                "null"
            ],
            "pattern": "^([6-9]\\d{9})?$"
        },
        "city": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
        },
        "state": {
            "type": "string",
            "maxLength": 100
        },
        "country": {
            "type": "string",
            "maxLength": 100
        },
        "preferredCountry": {
            "type": "string",
            "maxLength": 100
        },
        "qualification": {
            "type": "string",
            "maxLength": 255
        },
        "validAge": {
            "type": "boolean"
        }
    },
    "additionalProperties": true
}