{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$ref": "#/$defs/apiResponse",
    "$defs": {
        "apiResponse": {
            "type": "object",
            "properties": {
                "success": {
                    "type": "boolean"
                },
                "message": {
                    "type": "string"
                },
                "data": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "type": "integer"
                        },
                        "username": {
                            "type": "string"
                        },
                        "email": {
                            "type": "string"
                        },
                        "profilePictureUrl": {
                            "type": "string"
                        },
                        "createdAt": {
                            "type": "string"
                        },
                        "updatedAt": {
                            "type": "string"
                        }
                    },
                    "additionalProperties": true
                },
                "timestamp": {
                    "type": "string"
                }
            },
            "additionalProperties": true
        }
    }
}